<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ships unsandboxed: Developer ID + hardened runtime + notarization
         (development_workflow.md §2.4). Add entitlements here when the app
         needs them (microphone, camera, …). -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
